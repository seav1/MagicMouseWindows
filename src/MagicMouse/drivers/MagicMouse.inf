DeviceModel,,,,"Apple %MM3.Model%"
DeviceVendorWebsite,,,,%Website%
DeviceDetailedDescription,,,,"%MM3.Desc% %Desc.Suffix%"
[MM_AuxiliaryDevices]
[MM_AuxiliaryDevices.Services]
AddService=,2
[Wdf_Version]
KmdfLibraryVersion=1.15
[MM_AddReg]
HKR,,"SelectiveSuspendOn",0x00010001,0
HKR,,"LowerFilters",0x00010000,"MagicMouse"
[MM_Copy_Files]
MagicMouse.sys
