// Resource script for MagicMouse.
//   - Side-by-side manifest (Win10/11 supportedOS, DPI awareness)
//   - Version block
//   - Embedded driver files (auto-extracted on first run)

#include <winuser.h>
#include <winver.h>

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// Manifest -----------------------------------------------------------------
1 RT_MANIFEST "app.manifest"

// Embedded driver files - extracted to %TEMP% on first run, then handed to
// pnputil so PnP picks them up. IDs are referenced from MagicMouse.cpp.
#define RES_DRV_INF  100
#define RES_DRV_SYS  101
#define RES_DRV_CAT  102

RES_DRV_INF RCDATA "drivers\\MagicMouse.inf"
RES_DRV_SYS RCDATA "drivers\\MagicMouse.sys"
RES_DRV_CAT RCDATA "drivers\\MagicMouse.cat"

// Version block ------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MagicMouseWindows"
            VALUE "FileDescription",  "Magic Mouse for Windows"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "MagicMouse"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "MagicMouse.exe"
            VALUE "ProductName",      "Magic Mouse for Windows"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
