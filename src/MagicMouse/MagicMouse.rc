// Resource script for MagicMouse.
// Embeds the side-by-side manifest (Win10/11 supportedOS, DPI awareness)
// and the version block, no .ico file needed (icon is drawn at runtime).

#include <winuser.h>
#include <winver.h>

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MagicMouseWindows"
            VALUE "FileDescription",  "Magic Mouse for Windows (native)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MagicMouse"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "MagicMouse.exe"
            VALUE "ProductName",      "Magic Mouse for Windows"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
